{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yearline",
  "version": "1.2.0",
  "identifier": "com.yearline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
  "windows": [
    {
      "label": "main",
      "title": "Yearline",
      "width": 1600,
      "height": 1100,
      "minWidth": 1100,
      "minHeight": 680,
      "resizable": true,
      "maximized": false,
      "center": true,
      "dragDropEnabled": false,
      "zoomHotkeysEnabled": false
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}